# Stellar Payment Dashboard environment variables
# Copy this file to `.env` and adjust the values for your environment.

# Base URL of the backend API.
VITE_API_BASE=http://localhost:3000

# Stellar network the dashboard is connected to.
# Accepted values: `testnet` or `mainnet`.
# If unset, the network badge falls back to inferring the network from
# VITE_API_BASE and logs a console warning.
VITE_STELLAR_NETWORK=testnet
